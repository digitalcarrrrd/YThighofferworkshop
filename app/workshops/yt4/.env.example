# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOHIGHLEVEL INTEGRATION (Mode B)
GHL_LOCATION_ID="your_ghl_location_id"
GHL_PRIVATE_INTEGRATION_TOKEN="your_ghl_private_api_token"
GHL_BATCH_DATE_FIELD_KEY="custom_field_id_for_batch_date"
GHL_TRANSACTION_ID_FIELD_KEY="custom_field_id_for_transaction_id"
GHL_PAYMENT_METHOD_FIELD_KEY="custom_field_id_for_payment_method"
GHL_OFFER_VERSION_FIELD_KEY="custom_field_id_for_offer_version"
GHL_PAYMENT_PROOF_FIELD_KEY="custom_field_id_for_payment_proof"

# GOHIGHLEVEL EMBED MODE (Mode A)
# Paste GoHighLevel iframe or form share URL if you wish to use the embedded form mode in Step 2.
NEXT_PUBLIC_GHL_FORM_EMBED_URL=""

# ANALYTICS AND TRACKING
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_ID=""

